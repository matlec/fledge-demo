# Demo settings. Copy to .env; no secrets belong here.
# scripts/app-flows.py reads the ZEDEDA server and token from zcli's login
# (~/.config/zededa/zcli.json) and looks up the project from the cluster name.

# Cluster name from the ZEDEDA console (Edge Kubernetes > Clusters).
# Not the UUID, and not the node name.
ZEDEDA_CLUSTER=YOUR_CLUSTER_NAME

# Private GitHub repository containing the demo package. SSH URL required.
FLEDGE_GITOPS_REPOSITORY_URL=ssh://git@github.com/YOUR_OWNER/YOUR_REPOSITORY.git

# Optional: defaults shown. Names must be unique within the project.
FLEDGE_GITOPS_NAME=fledge-demo
FLEDGE_GITOPS_SECRET=fledge-demo-git
# Relative directory containing fleet.yaml in the repository.
FLEDGE_GITOPS_PATH=deploy/fledge
