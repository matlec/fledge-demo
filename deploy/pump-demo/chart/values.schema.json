{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "simulator",
    "influxdb",
    "grafana"
  ],
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[._:/-][a-z0-9]+)*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "simulator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "serverSecret",
        "operatorSecret",
        "seed",
        "resources"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "serverSecret": {
          "type": "string",
          "minLength": 1
        },
        "operatorSecret": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "influxdb": {
      "type": "object",
      "required": [
        "image",
        "org",
        "bucket",
        "retention",
        "existingClaim",
        "adminSecret",
        "resources"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "org": {
          "type": "string",
          "minLength": 1
        },
        "bucket": {
          "type": "string",
          "minLength": 1
        },
        "retention": {
          "type": "string",
          "pattern": "^[0-9]+[hdw]$"
        },
        "existingClaim": {
          "type": "string",
          "minLength": 1
        },
        "adminSecret": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "grafana": {
      "type": "object",
      "required": [
        "image",
        "adminSecret",
        "tokenSecret",
        "service",
        "resources"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "adminSecret": {
          "type": "string",
          "minLength": 1
        },
        "tokenSecret": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "object",
          "required": [
            "type",
            "nodePort"
          ],
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort"
              ]
            },
            "nodePort": {
              "type": "integer",
              "minimum": 30000,
              "maximum": 32767
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "global": {
      "type": "object",
      "description": "Values that Fleet injects, such as global.fleet.clusterLabels"
    }
  },
  "additionalProperties": false
}
