{
  "uid": "fledge-pumps",
  "title": "Pumps",
  "tags": [
    "fledge"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "pump",
        "label": "Pump",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "query": "Pump1,Pump2,Pump3",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Data age",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"{{ .Values.influxdb.bucket }}\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"fledge\" and r._field == \"Speed\" and r.asset =~ /^${pump:regex}$/)\n  |> last()\n  |> map(fn: (r) => ({r with _value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"asset\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.asset}",
          "unit": "s",
          "decimals": 1,
          "noValue": "no data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "description": "Time since the newest point of each pump in InfluxDB. Orange after 10 s, red after 30 s."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scenario (ground truth)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"{{ .Values.influxdb.bucket }}\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"fledge\" and r._field == \"Scenario\" and r.asset =~ /^${pump:regex}$/)\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"asset\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.asset}",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "normal": {
                  "color": "green",
                  "index": 0
                },
                "bearing-wear": {
                  "color": "red",
                  "index": 1
                },
                "cavitation": {
                  "color": "orange",
                  "index": 2
                },
                "impeller-wear": {
                  "color": "purple",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Pump/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "description": "The fault scenario that the simulator runs, set with pump-control."
    },
