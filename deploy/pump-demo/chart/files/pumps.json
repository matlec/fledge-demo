    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Anomaly score and severity",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "import \"strings\"\nfrom(bucket: \"{{ .Values.influxdb.bucket }}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"fledge\" and r.asset =~ /^(${pump:regex})Score$/)\n  |> filter(fn: (r) => r._field == \"AnomalyScore\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> map(fn: (r) => ({r with asset: strings.trimSuffix(v: r.asset, suffix: \"Score\")}))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"asset\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
