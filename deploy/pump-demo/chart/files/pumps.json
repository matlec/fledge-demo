          },
          "query": "import \"strings\"\nfrom(bucket: \"{{ .Values.influxdb.bucket }}\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"fledge\" and r._field == \"AnomalyScore\" and r.asset =~ /^(${pump:regex})Score$/)\n  |> last()\n  |> map(fn: (r) => ({r with asset: strings.trimSuffix(v: r.asset, suffix: \"Score\")}))\n  |> map(fn: (r) => ({r with _value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"asset\"])"
